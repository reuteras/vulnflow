# ./poc.sh init copies this to .env (mode 600) and generates every empty secret below
# that it knows about. The bootstrap commands fill in the API keys/tokens. Never commit .env.
# Keys are sorted within each blank-line-separated section (dotenv-linter in CI).

# ---- Upstream versions ---------------------------------------------------
# Dependency-Track: image tags live in stacks/dependency-track/docker-compose.yml
# (Dependabot keeps them current).
# DefectDojo git tag; also used as the image tag (DJANGO_VERSION/NGINX_VERSION).
# "master" = DefectDojo's release branch with :latest images.
DD_REF=3.5.300
# OpenCVE git tag for the clone and install.sh -r <ref>; empty = upstream master
OPENCVE_REF=v3.1.0

# ---- Ports (all bound to 127.0.0.1) ------------------------------------
# OpenCVE keeps its upstream ports (web 80, Airflow 8080); opencve-prepare binds them to
# 127.0.0.1 in upstream/opencve/docker/.env
DD_PORT=8280
DT_API_PORT=8180
DT_UI_PORT=8181
VULNFLOW_PORT=8380

# ---- Tailscale (browser access) ----------------------------------------
# Empty = local only (reach the UIs with ssh -L). Set to this node's tailnet name
# (vulnflow.tail1234.ts.net), or "auto" to take it from `tailscale status`, and poc.sh
# serves OpenCVE on https://<name>, DT on :8181 (API :8180) and DefectDojo on :8280 with
# `tailscale serve`, tailnet only. It also rewrites the browser-facing URLs below
# (DT_PUBLIC_API_URL, DD_SITE_URL, DD_CSRF_TRUSTED_ORIGINS, OPENCVE_URL). After a change:
# ./poc.sh tailscale
# DT_PUBLIC_API_URL: URL the browser uses for the DT API (baked into the DT frontend container)
DT_PUBLIC_API_URL=http://localhost:8180
# The DT UI for links in the email reports; empty = DT_PUBLIC_API_URL's host on DT_UI_PORT
# DT_PUBLIC_UI_URL=
VULNFLOW_TS_HOST=

# ---- Dependency-Track ---------------------------------------------------
# admin password; generated by init, set on first start by dtrack-up/dt-bootstrap
DT_ADMIN_PASSWORD=
# Filled in by dtrack-up/dt-bootstrap: key of team 'vulnflow' with BOM_UPLOAD,
# PROJECT_CREATION_UPLOAD, VIEW_PORTFOLIO, VIEW_VULNERABILITY
DT_API_KEY=
DT_DB_PASSWORD=
# Filled in by dt-bootstrap: key of team 'vulnflow-maintenance' (VIEW_PORTFOLIO,
# VIEW_VULNERABILITY, VULNERABILITY_ANALYSIS, PORTFOLIO_MANAGEMENT) for `prune`, which the
# dt2dojo loop runs every round. Empty = no pruning.
DT_MAINTENANCE_API_KEY=
# OSV ecosystems dt-bootstrap makes sure are enabled (added to any already set; OSV is off
# in DT 5.2.2 by default and has no Debian). Empty = leave DT's OSV config alone.
DT_OSV_ECOSYSTEMS=Debian,PyPI,crates.io
# Dependency-Track telemetry: once a day a cluster id, the DT version and the database type
# and version to metrics.dependencytrack.org. Off unless true; dt-bootstrap applies it.
DT_TELEMETRY=false
DT_URL=http://localhost:8180

# ---- DefectDojo ---------------------------------------------------------
# Generated by init; the initializer creates the admin with it on first start only
DD_ADMIN_PASSWORD=
DD_ADMIN_USER=admin
# Filled in by dojo-up/dd-bootstrap: the admin's API v2 key
DD_API_KEY=
# DD_CREDENTIAL_AES_256_KEY and DD_SECRET_KEY are generated by init and replace
# upstream's hard-coded defaults. Changing them later invalidates sessions and
# stored (encrypted) tool credentials.
DD_CREDENTIAL_AES_256_KEY=
# Origins allowed to POST forms (comma-separated, with scheme); see VULNFLOW_TS_HOST
DD_CSRF_TRUSTED_ORIGINS=http://localhost:8280
DD_SECRET_KEY=
# Browser-facing URL used in DefectDojo's links and notifications
DD_SITE_URL=http://localhost:8280
DD_URL=http://localhost:8280

# ---- OpenCVE ------------------------------------------------------------
# Human admin created by opencve-bootstrap (superuser, email pre-verified, org owner).
# Only created if the username doesn't exist; an existing user is never changed.
OPENCVE_ADMIN_EMAIL=admin@localhost.invalid
# Generated by init
OPENCVE_ADMIN_PASSWORD=
OPENCVE_ADMIN_USER=admin
# Optional: API URL if it differs from OPENCVE_URL for this process. The receiver
# container gets http://webserver:8000 from deploy/docker-compose.glue-opencve.yml.
OPENCVE_API_URL=
# Letters, digits and dashes only (OpenCVE rule)
OPENCVE_ORG=polisen-poc
# Filled in by opencve-bootstrap: read-write org token, opc_org.<id>.<secret>
OPENCVE_TOKEN=
# Browser-facing URL (chat links) and API URL for commands run on this host
OPENCVE_URL=http://localhost

# ---- Webhook receiver / enrichment --------------------------------------
# Use your own Vulnerability-Lookup instance here if you run one
CIRCL_URL=https://vulnerability.circl.lu
# VulnCheck KEV (optional; a free community token from vulncheck.com): adds the CVEs it
# lists beyond CISA KEV, weighted like CISA's and labelled "VulnCheck KEV". The whole index
# is downloaded (every 6 h); requests carry the token, never CVE ids. Empty = CISA KEV only.
VULNCHECK_API_TOKEN=
# Optional chat webhook (Teams/Mattermost/Slack-compatible {"text": ...}); empty = log only.
# ./poc.sh chat-up sets it to the local Mattermost's alerts channel.
VULNFLOW_CHAT_WEBHOOK=
# Channels of noisy products ([chat.<name>] in machines.toml) get VULNFLOW_CHAT_WEBHOOK_<NAME>
# from ./poc.sh chat-up; no entry here.
# Enrichment sends CVE IDs (only) to these public services. Set to 0 to disable each.
VULNFLOW_ENRICH_CIRCL=1
VULNFLOW_ENRICH_EPSS=1
VULNFLOW_ENRICH_KEV=1
# Write-back: set OpenCVE status "to_evaluate" on P1..P<n> CVEs that nobody has triaged
# yet (0 = off). Needs a read-write OPENCVE_TOKEN.
VULNFLOW_OPENCVE_TRIAGE_MAX_TIER=2
# Optional paging: new P1 Dependency-Track findings on a critical asset (finding-watch in
# each dt2dojo round). json = {"text": ...}; text = plain body with ntfy's headers.
VULNFLOW_PAGE_FORMAT=json
VULNFLOW_PAGE_WEBHOOK=
# Optional SOC channel: every alert at or above VULNFLOW_SOC_MIN_TIER (1 = P1), whatever
# the team, unrouted included, to a second webhook. ./poc.sh chat-up sets it to the local
# Mattermost's soc channel.
VULNFLOW_SOC_MIN_TIER=1
VULNFLOW_SOC_WEBHOOK=
# Shared secret OpenCVE sends as a custom header (X-Vulnflow-Token) on its webhook
VULNFLOW_WEBHOOK_TOKEN=
# Where OpenCVE posts webhooks: the receiver's alias on OpenCVE's docker network
VULNFLOW_WEBHOOK_URL=http://vulnflow-receiver:8380/opencve

# ---- Own machines (push agents) -----------------------------------------
# URL the agents on your machines upload to; empty = DT_PUBLIC_API_URL (the tailnet URL
# once VULNFLOW_TS_HOST is set). See docs/sboms.md "Own machines".
VULNFLOW_AGENT_DT_URL=
# Network/appliance devices and their versions (CSV, or .json); not in git (copy
# devices.example.csv). See docs/sboms.md "From a device list".
VULNFLOW_DEVICES=devices.csv
# Optional read-only GitHub token for [github.*] in machines.toml (public repositories
# need none; it only raises the API limit of 60 requests an hour). Not sent with downloads.
VULNFLOW_GITHUB_TOKEN=
# Your hosts and groups; not in git (copy machines.example.toml)
VULNFLOW_MACHINES=machines.toml

# ---- Local chat (optional, ./poc.sh chat-up: Mattermost Team Edition) ---
MM_ADMIN_PASSWORD=
MM_ADMIN_USER=admin
MM_DB_PASSWORD=
MM_PORT=8065
# Browser-facing URL; set by tailscale serve (VULNFLOW_TS_HOST)
MM_SITE_URL=http://localhost:8065

# ---- Email reports (./poc.sh report, ./poc.sh schedule install) ----------
# Recipient(s), comma-separated; sent with this host's sendmail. Empty = print only.
VULNFLOW_REPORT_TO=
