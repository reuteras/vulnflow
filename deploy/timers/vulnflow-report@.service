# vulnflow daily/weekly report (instance = daily or weekly), mailed with the host's sendmail.
# Installed by `./poc.sh schedule install`, which fills in @ROOT@ and @USER@; started by
# vulnflow-report-daily.timer and vulnflow-report-weekly.timer.
[Unit]
Description=vulnflow %i report
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/poc.sh report %i
# No NoNewPrivileges: postfix's sendmail hands the mail to postdrop, which is setgid.
